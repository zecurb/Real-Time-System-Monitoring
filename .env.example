RTMONITOR_DATABASE_URL=postgresql+asyncpg://rtmonitor:rtmonitor-development-only@127.0.0.1:5432/rtmonitor
RTMONITOR_MAX_REQUEST_BYTES=65536
RTMONITOR_WORKER_BATCH_SIZE=100
RTMONITOR_WORKER_LEASE_SECONDS=30
RTMONITOR_WORKER_POLL_SECONDS=2
RTMONITOR_WORKER_MAX_ATTEMPTS=5
RTMONITOR_WORKER_RETRY_BASE_SECONDS=5
